# Server
PORT=3001
NODE_ENV=development

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (for geospatial presence store)
# Local: redis://localhost:6379
# Production (Upstash): redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# JWT secret for auth tokens — MUST be set in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# LiveKit (SFU for WebRTC audio)
# Local: ws://localhost:7880
# Production (LiveKit Cloud): wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Twilio (phone verification)
# Get from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
