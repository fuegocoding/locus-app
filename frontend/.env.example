# Backend server
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# JWT secret — MUST be set. Generate with: openssl rand -hex 32
# Must match the server's JWT_SECRET exactly.
JWT_SECRET=

# MapLibre / map tiles (no token required for free CartoDB tiles)
# Optional: MaptTiler API key for higher quality tiles
NEXT_PUBLIC_MAPTILER_KEY=

# App URL (used for invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
